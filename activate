#!/usr/bin/env bash
# ============================================================================
# venv-style activation of the Kubot dev environment for an interactive shell.
#
#   source ./activate       (bash / zsh, repo root)
#   source ./activate.fish  (fish)
#   .\activate.ps1          (PowerShell)
#
# Applies the composed pm env (PATH + tool vars) to the CURRENT shell, with
# save/restore: `deactivate` undoes exactly what activation changed.
#
# `kubot` becomes a shell function for this checkout. It runs only while the
# shell is inside this worktree and refuses outside it, so a sibling worktree
# keeps its own command. A prompt prefix names the worktree.
#
# Scripts and other processes do not source this: they run under
# `scripts/run-in-kubot-env`. Both build on scripts/_activation.sh.
#
# Sync through setup before selecting the environment. PM owns freshness;
# activation does not maintain a second dependency stamp. It trusts the
# recorded tool digest instead of re-hashing every entry. `kubot pm
# install` and `kubot update` keep that check.
# ============================================================================
_KUBOT_REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# Options: `--test-extras a,b` selects the test environment's runtime extras
# (default: [all]); `--` ends options.
# A bare `source ./activate` inherits the caller's positional parameters.
# Ignore unrelated words so scripts with their own arguments can source it.
_kubot_test_env="--test-environment"
_kubot_expect_extras=""
for _kubot_arg in "$@"; do
    if [ -n "$_kubot_expect_extras" ]; then
        _kubot_test_env="--test-environment=$_kubot_arg"
        _kubot_expect_extras=""
        continue
    fi
    case "$_kubot_arg" in
        --) break ;;
        --test-extras) _kubot_expect_extras=1 ;;
        --test-extras=*) _kubot_test_env="--test-environment=${_kubot_arg#--test-extras=}" ;;
        *) : ;;
    esac
done
if [ -n "$_kubot_expect_extras" ]; then
    printf '%s\n' 'activate: --test-extras needs a comma-separated list' >&2
    unset _kubot_arg _kubot_test_env _kubot_expect_extras
    return 2 2>/dev/null || exit 2
fi
unset _kubot_arg _kubot_expect_extras

# shellcheck source=scripts/_activation.sh
. "$_KUBOT_REPO/scripts/_activation.sh"

if ! kubot_sync "$_KUBOT_REPO" "$_kubot_test_env"; then
    printf '%s\n' 'activate: setup failed; shell environment unchanged' >&2
    unset _kubot_test_env
    return 1 2>/dev/null || exit 1
fi
unset _kubot_test_env

# Guard against double-sourcing: venv activate precedent (re-activating is a
# no-op re-save; we keep it idempotent by deactivating first). Key on the
# function, not the sentinel: child shells inherit __KUBOT_ACTIVATED from an
# activated parent but never the function, and there is nothing to undo there.
if [ "$(type -t deactivate 2>/dev/null)" = "function" ]; then
    deactivate
fi

_kubot_script="$(kubot_compose_env "$_KUBOT_REPO" sh)" || {
    echo "activate: could not compose the environment (see above)" >&2
    unset _kubot_script
    return 1 2>/dev/null || exit 1
}
_kubot_keys="$(printf '%s\n' "$_kubot_script" | sed -n 's/^export \([A-Za-z_][A-Za-z0-9_]*\)=.*/\1/p' | tr '\n' ' ')"

# --- snapshot what we are about to change (deactivate restores this) ---
# __KUBOT_ACTIVATED is part of the composed env below (it carries the
# installed-state path this environment was built from), so it is snapshotted
# and exported with every other key — no separate assignment here.
__KUBOT_SAVED_PATH="$PATH"
for _kubot_k in $_kubot_keys; do
    eval "__KUBOT_SAVED_$_kubot_k=\"\${$_kubot_k+set}\""
    eval "__KUBOT_PRIOR_$_kubot_k=\${$_kubot_k-__KUBOT_UNSET__}"
done
kubot_apply_env "$_kubot_script"

# This checkout, not whichever `kubot` PATH finds. A function beats PATH, an
# alias, and a hashed command, including the MSIX execution alias.
__KUBOT_WORKTREE="$_KUBOT_REPO"
# The branch names the worktree. A checkout cannot share a branch with another.
__KUBOT_WORKTREE_NAME="$(git -C "$_KUBOT_REPO" rev-parse --abbrev-ref HEAD 2>/dev/null || :)"
if [ -z "$__KUBOT_WORKTREE_NAME" ] || [ "$__KUBOT_WORKTREE_NAME" = HEAD ]; then
    __KUBOT_WORKTREE_NAME="$(basename "$_KUBOT_REPO")"
fi
__KUBOT_SAVED_PS1="${PS1-__KUBOT_UNSET__}"
__KUBOT_SAVED_PROMPT_COMMAND="${PROMPT_COMMAND-__KUBOT_UNSET__}"

_kubot_worktree_here() {
    _kubot_top="$(git rev-parse --show-toplevel 2>/dev/null)" || return 1
    [ "$(cd "$_kubot_top" && pwd -P)" = "$(cd "$__KUBOT_WORKTREE" && pwd -P)" ]
}

kubot() {
    _kubot_worktree_here || {
        printf '%s\n' "kubot: $(pwd) is outside $__KUBOT_WORKTREE; refusing (the installed command is hidden while this checkout is active)" >&2
        return 1
    }
    (
        cd "$__KUBOT_WORKTREE" || exit 1
        if [ -n "${PYTHON-}" ]; then
            exec "$PYTHON" kubot "$@"
        elif [ -x .venv/Scripts/python.exe ]; then
            exec .venv/Scripts/python.exe kubot "$@"
        elif [ -x .venv/bin/python ]; then
            exec .venv/bin/python kubot "$@"
        elif [ -x venv/Scripts/python.exe ]; then
            exec venv/Scripts/python.exe kubot "$@"
        elif [ -x venv/bin/python ]; then
            exec venv/bin/python kubot "$@"
        else
            exec python kubot "$@"
        fi
    )
}

_kubot_prompt() {
    if [ "$__KUBOT_SAVED_PS1" = "__KUBOT_UNSET__" ]; then
        _kubot_base_ps1=""
    else
        _kubot_base_ps1="$__KUBOT_SAVED_PS1"
    fi
    if _kubot_worktree_here; then
        PS1="($__KUBOT_WORKTREE_NAME) $_kubot_base_ps1"
    else
        PS1="$_kubot_base_ps1"
    fi
}

if [ -n "${PROMPT_COMMAND-}" ]; then
    PROMPT_COMMAND="_kubot_prompt; ${PROMPT_COMMAND}"
else
    PROMPT_COMMAND=_kubot_prompt
fi
_kubot_prompt

deactivate() {
    export PATH="$__KUBOT_SAVED_PATH"
    for _kubot_k in $__KUBOT_KEY_LIST; do
        eval "_kubot_was=\"\$__KUBOT_SAVED_$_kubot_k\""
        eval "_kubot_old=\"\$__KUBOT_PRIOR_$_kubot_k\""
        if [ "$_kubot_was" != "set" ]; then
            unset "$_kubot_k"
        else
            export "$_kubot_k=$_kubot_old"
        fi
        unset "__KUBOT_SAVED_$_kubot_k" "__KUBOT_PRIOR_$_kubot_k"
    done
    if [ "$__KUBOT_SAVED_PS1" = "__KUBOT_UNSET__" ]; then
        unset PS1
    else
        PS1="$__KUBOT_SAVED_PS1"
    fi
    if [ "$__KUBOT_SAVED_PROMPT_COMMAND" = "__KUBOT_UNSET__" ]; then
        unset PROMPT_COMMAND
    else
        PROMPT_COMMAND="$__KUBOT_SAVED_PROMPT_COMMAND"
    fi
    unset __KUBOT_SAVED_PATH __KUBOT_KEY_LIST __KUBOT_ACTIVATED \
          __KUBOT_WORKTREE __KUBOT_WORKTREE_NAME \
          __KUBOT_SAVED_PS1 __KUBOT_SAVED_PROMPT_COMMAND
    unset -f deactivate kubot _kubot_worktree_here _kubot_prompt
    unset _kubot_k _kubot_was _kubot_old _kubot_top
}

# remember the key list for deactivate (kept out of the loop vars above)
__KUBOT_KEY_LIST="$_kubot_keys"

# The composition library is not part of the user's shell.
unset -f kubot_sync kubot_bootstrap_python kubot_compose_env kubot_apply_env \
         kubot_activation_current kubot_ensure_env
unset _KUBOT_REPO _kubot_script _kubot_keys _kubot_k _kubot_top
